# Copy this file to .env and fill in your real values.
# Get these from your Supabase project: Project Settings -> API
# Never commit the real .env file to version control.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Do NOT put the service_role key here or anywhere in this frontend
# project. It bypasses all security (RLS, license checks) and must
# only ever be used in a trusted server-side environment, never
# shipped to a browser.
